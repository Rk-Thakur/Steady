      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"settings_rows\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"currency\" TEXT NOT NULL, \"pay_frequency\" TEXT NOT NULL, \"next_payday\" TEXT NOT NULL, \"income_type\" TEXT NOT NULL, \"display_name\" TEXT NULL, \"hourly_rate_cents\" INTEGER NULL, \"week_starts_on\" INTEGER NOT NULL DEFAULT 7, \"theme\" TEXT NOT NULL, \"app_lock_enabled\" INTEGER NOT NULL DEFAULT 0 CHECK (\"app_lock_enabled\" IN (0, 1)), \"overspend_strategy\" TEXT NOT NULL, \"onboarded\" INTEGER NOT NULL DEFAULT 0 CHECK (\"onboarded\" IN (0, 1)), PRIMARY KEY (\"id\"));"
        }
      ]
    },
