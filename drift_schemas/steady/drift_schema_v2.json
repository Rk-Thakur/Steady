      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"entries\" (\"id\" TEXT NOT NULL, \"type\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL CHECK(\"amount_cents\" > 0), \"local_date\" TEXT NOT NULL, \"created_at_utc\" INTEGER NOT NULL, \"time_zone_id\" TEXT NOT NULL, \"merchant\" TEXT NULL, \"category_id\" TEXT NULL, \"mood\" TEXT NULL, \"planned\" INTEGER NULL CHECK (\"planned\" IN (0, 1)), \"note\" TEXT NULL, \"split_id\" TEXT NULL, \"to_vault\" INTEGER NOT NULL DEFAULT 0 CHECK (\"to_vault\" IN (0, 1)), \"from_vault\" INTEGER NOT NULL DEFAULT 0 CHECK (\"from_vault\" IN (0, 1)), \"bill_id\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "bills",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"bills\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"amount_cents\" INTEGER NOT NULL, \"recurrence\" TEXT NOT NULL, \"due_date\" TEXT NOT NULL, \"is_estimate\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_estimate\" IN (0, 1)), \"is_subscription\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_subscription\" IN (0, 1)), \"needs_review\" INTEGER NOT NULL DEFAULT 0 CHECK (\"needs_review\" IN (0, 1)), \"last_paid_on\" TEXT NULL, \"previous_amount_cents\" INTEGER NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "goals",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"goals\" (\"id\" TEXT NOT NULL, \"name\" TEXT NOT NULL, \"kind\" TEXT NOT NULL, \"target_cents\" INTEGER NOT NULL, \"saved_cents\" INTEGER NOT NULL, \"daily_set_aside_cents\" INTEGER NOT NULL, \"target_date\" TEXT NULL, \"paused\" INTEGER NOT NULL DEFAULT 0 CHECK (\"paused\" IN (0, 1)), \"sort_order\" INTEGER NOT NULL DEFAULT 0, PRIMARY KEY (\"id\"));"
        }
      ]
    },
    {
      "name": "vaults",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"vaults\" (\"id\" INTEGER NOT NULL DEFAULT 1, \"opening_balance_cents\" INTEGER NOT NULL, \"steady_pay_weekly_cents\" INTEGER NOT NULL, \"target_weeks\" INTEGER NOT NULL DEFAULT 4, \"last_release_date\" TEXT NULL, PRIMARY KEY (\"id\"));"
        }
      ]
    },
