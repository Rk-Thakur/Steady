<?xml version="1.0" encoding="utf-8"?>
<!-- Handoff 4: Steady's data is never copied off the device automatically.
     Excludes everything from Google Drive backup and device-to-device
     transfer (Android 12+); allowBackup="false" covers older versions.
     Users move data with the encrypted .steady backup file instead. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
